# Sao chep file nay thanh .env roi chinh sua (khong commit .env).
# Mat khau SQL Server: >= 8 ky tu, co chu hoa, chu thuong, so va ky tu dac biet.
MSSQL_DB=FamilyConnect
MSSQL_USER=sa
MSSQL_SA_PASSWORD=FamilyConnect_2025!
MSSQL_HOST=localhost
MSSQL_PORT=1433
JWT_SECRET_KEY=dev-familyconnect-secret-change-before-deployment-32-chars-min
BACKEND_PORT=8000
WEB_PORT=3000
WEB_DEV_PORT=5173

# Cau hinh Google Gemini AI (Thanh vien 5)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=256
GEMINI_CHAT_MODEL=gemini-2.5-flash
