# Sao chép thành .env tại GỐC dự án; không commit .env.
# Đây là cấu hình mục tiêu; config.py hiện mới đọc APP_NAME/DB_SERVER/DB_NAME.
APP_NAME=FamilyConnect
APP_ENV=development
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FamilyConnectDB
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_AUTH_MODE=windows
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
FRONTEND_ORIGIN=http://localhost:8000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
AI_ENABLED=false
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=
EMBEDDING_MODEL=
REMINDER_MINUTES_BEFORE=1440
# Container Linux cần cấu hình xác thực riêng; không tự kế thừa Windows Authentication.
# Với môi trường demo chứng chỉ tự ký, cấu hình tin cậy phải được ghi rõ trong hướng dẫn.
